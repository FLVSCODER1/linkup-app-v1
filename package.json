{
  "name": "nextjs",
  "version": "0.8.0-beta.1",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project demo-linkup \"vitest run --config vitest.rules.config.ts\"",
    "lint": "eslint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "check": "npm run test && npm run test:rules && npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "firebase": "^12.17.1",
    "firebase-admin": "13.9.0",
    "next": "^16.3.0",
    "node-ical": "^0.26.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.0",
    "firebase-tools": "^14.27.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "websocket-driver": "0.7.5"
  }
}
