rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return signedIn()
        && (
          request.auth.token.email_verified == true
          || request.auth.token.get('linkup_verified', false) == true
        );
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userSchool() {
      return userDoc().data.school;
    }

    function userDistrict() {
      return userDoc().data.district;
    }

    function publishedEventIsVisible(eventData) {
      return eventData.status == 'published'
        && (
          (
            eventData.visibility == 'school'
            && userSchool() != null
            && userDistrict() != null
            && eventData.school == userSchool()
            && eventData.district == userDistrict()
          )
          ||
          (
            eventData.visibility == 'district'
            && userDistrict() != null
            && eventData.district == userDistrict()
          )
        );
    }

    function publishedEventByIdIsVisible(eventId) {
      return publishedEventIsVisible(
        get(/databases/$(database)/documents/events/$(eventId)).data
      );
    }

    function validHostEventData(eventData) {
      return eventData.title is string
        && eventData.title.size() >= 3
        && eventData.title.size() <= 100
        && eventData.description is string
        && eventData.description.size() <= 1000
        && eventData.location is string
        && eventData.location.size() <= 120
        && eventData.category in [
          'social',
          'sports',
          'academic',
          'club',
          'arts',
          'music',
          'volunteering',
          'gaming',
          'fundraiser',
          'competition',
          'other'
        ]
        && eventData.startTime is timestamp
        && (
          eventData.get('endTime', null) == null
          || (
            eventData.endTime is timestamp
            && eventData.endTime > eventData.startTime
          )
        )
        && (
          eventData.get('rsvpDeadline', null) == null
          || (
            eventData.rsvpDeadline is timestamp
            && eventData.rsvpDeadline <= eventData.startTime
          )
        )
        && eventData.status in ['draft', 'published', 'cancelled']
        && eventData.visibility in ['school', 'district']
        && (
          eventData.get('coverImagePath', null) == null
          || eventData.coverImagePath is string
        )
        && (
          eventData.get('capacity', null) == null
          || (
            eventData.capacity is int
            && eventData.capacity >= 2
            && eventData.capacity <= 10000
          )
        );
    }

    function validCoverImagePath(eventData, eventId) {
      return eventData.get('coverImagePath', null) == null
        || (
          eventData.coverImagePath is string
          && eventData.coverImagePath.matches(
            'event-covers/' + eventId + '/[A-Za-z0-9_-]+[.]webp'
          )
        );
    }

    function validHostEventCreationData(eventData) {
      return eventData.keys().hasAll([
          'title',
          'description',
          'location',
          'category',
          'district',
          'school',
          'visibility',
          'status',
          'createdBy',
          'hostName',
          'source',
          'imported',
          'startTime',
          'endTime',
          'capacity',
          'rsvpDeadline',
          'attendeeCount',
          'coverImagePath',
          'moderationStatus',
          'suppressionReason',
          'relevanceScore',
          'aiCategory',
          'reviewedAt',
          'reviewedBy',
          'createdAt',
          'updatedAt',
          'publishedAt'
        ])
        && eventData.keys().hasOnly([
          'title',
          'description',
          'location',
          'category',
          'district',
          'school',
          'visibility',
          'status',
          'createdBy',
          'hostName',
          'source',
          'imported',
          'startTime',
          'endTime',
          'capacity',
          'rsvpDeadline',
          'attendeeCount',
          'coverImagePath',
          'moderationStatus',
          'suppressionReason',
          'relevanceScore',
          'aiCategory',
          'reviewedAt',
          'reviewedBy',
          'createdAt',
          'updatedAt',
          'publishedAt'
        ])
        && eventData.createdBy is string
        && eventData.hostName is string
        && eventData.hostName.size() >= 2
        && eventData.hostName.size() <= 50
        && eventData.district is string
        && eventData.school is string
        && eventData.source == 'user-posted'
        && eventData.imported == false
        && eventData.attendeeCount == 0
        && eventData.moderationStatus == 'pending'
        && eventData.suppressionReason == null
        && eventData.relevanceScore == 0
        && eventData.aiCategory == null
        && eventData.reviewedAt == null
        && eventData.reviewedBy == null
        && eventData.createdAt == request.time
        && eventData.updatedAt == request.time
        && (
          (eventData.status == 'draft' && eventData.publishedAt == null)
          || (
            eventData.status == 'published'
            && eventData.publishedAt == request.time
          )
        );
    }

    match /users/{userId} {
      allow read: if isVerified()
        && (
          isOwner(userId)
          || (
            resource.data.school == userSchool()
            && resource.data.district == userDistrict()
          )
        );

      // Initial identity and school assignment are written only by the
      // server-side verified profile endpoint.
      allow create: if false;

      allow update: if isVerified()
        && isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName',
          'grade',
          'bio',
          'interests',
          'profileComplete',
          'updatedAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 50
        && request.resource.data.grade in ['9', '10', '11', '12']
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 250
        && request.resource.data.interests is list
        && request.resource.data.interests.size() <= 10;

      allow delete: if false;
    }

    match /users/{userId}/savedEvents/{eventId} {
      allow read: if isVerified() && isOwner(userId);

      allow create, update: if isVerified()
        && isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.eventId == eventId
        && publishedEventByIdIsVisible(eventId);

      allow delete: if isVerified() && isOwner(userId);
    }

    // Legal surnames are stored separately from public school profiles and are
    // available only through authenticated server endpoints.
    match /privateUserProfiles/{document=**} {
      allow read, write: if false;
    }

    match /events/{eventId} {
      allow read: if isVerified()
        && (
          publishedEventIsVisible(resource.data)
          || request.auth.uid == resource.data.createdBy
        );

      allow create: if isVerified()
        && validHostEventData(request.resource.data)
        && validHostEventCreationData(request.resource.data)
        && validCoverImagePath(request.resource.data, eventId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status in ['draft', 'published']
        && request.resource.data.school == userSchool()
        && request.resource.data.district == userDistrict();

      allow update: if isVerified()
        && request.auth.uid == resource.data.createdBy
        && validHostEventData(request.resource.data)
        && validCoverImagePath(request.resource.data, eventId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title',
          'description',
          'location',
          'category',
          'startTime',
          'endTime',
          'capacity',
          'rsvpDeadline',
          'visibility',
          'status',
          'coverImagePath',
          'publishedAt',
          'updatedAt'
        ])
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.school == resource.data.school
        && request.resource.data.district == resource.data.district
        && request.resource.data.updatedAt == request.time
        && (
          (
            request.resource.data.status == 'draft'
            && request.resource.data.publishedAt == null
          )
          || (
            request.resource.data.status == 'published'
            && request.resource.data.publishedAt is timestamp
            && (
              (
                resource.data.status == 'published'
                && request.resource.data.publishedAt == resource.data.publishedAt
              )
              || (
                resource.data.status != 'published'
                && request.resource.data.publishedAt == request.time
              )
            )
          )
          || (
            request.resource.data.status == 'cancelled'
            && request.resource.data.publishedAt == resource.data.publishedAt
          )
        );

      allow delete: if isVerified()
        && request.auth.uid == resource.data.createdBy;
    }

    match /events/{eventId}/attendees/{userId} {
      allow read: if isVerified()
        && publishedEventByIdIsVisible(eventId);

      // Attendance writes use a server transaction so capacity, deadlines,
      // counts, and duplicate prevention cannot be bypassed by clients.
      allow create, update, delete: if false;
    }

    // Legacy top-level attendee documents are no longer used.
    match /attendees/{userId} {
      allow read, write: if false;
    }

    match /eventPreferences/{prefId} {
      allow read: if isVerified()
        && resource.data.school == userSchool()
        && publishedEventByIdIsVisible(resource.data.eventId);

      // Preference writes are committed atomically with attendance.
      allow create, update, delete: if false;
    }

    match /interests/{interestId} {
      allow read: if isVerified()
        && (
          resource.data.fromUserId == request.auth.uid
          || resource.data.toUserId == request.auth.uid
        );

      allow create, update: if isVerified()
        && request.resource.data.fromUserId == request.auth.uid;

      allow delete: if isVerified()
        && resource.data.fromUserId == request.auth.uid;
    }

    // Directory, admin-role, and verification records are server-only.
    match /districts/{document=**} {
      allow read, write: if false;
    }

    match /schools/{document=**} {
      allow read, write: if false;
    }

    match /schoolDomains/{document=**} {
      allow read, write: if false;
    }

    match /admins/{document=**} {
      allow read, write: if false;
    }

    match /accountVerifications/{document=**} {
      allow read, write: if false;
    }

    match /schoolRequests/{document=**} {
      allow read, write: if false;
    }

    match /calendarImportRequests/{document=**} {
      allow read, write: if false;
    }

    match /calendarSources/{document=**} {
      allow read, write: if false;
    }
  }
}
